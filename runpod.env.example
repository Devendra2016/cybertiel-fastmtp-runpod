# RunPod A40-class profile matching the supplied pod:
# 48 GB VRAM / 50 GB RAM / 9 vCPU.
#
# The Cyber-Tiel Q6 MTP file is 32.2 GB, leaving substantial VRAM for
# Q8 KV cache and runtime buffers. RunPod's A40 has 48 GB VRAM.
MODEL_REPO=peculiar-ragdoll/Cyber-Tiel-Coder-35B-A3B-GGUF-MTP
MODEL_FILE=Cyber-Tiel-Coder-35B-A3B-MTP-UD-Q6_K_XL.gguf
MODEL_DIR=/workspace/models

# RunPod HTTP proxy
HOST=0.0.0.0
PORT=8000

# HF token: create a RunPod Secret/Environment Variable named HF_TOKEN.
# Do NOT commit the token to GitHub.
HF_TOKEN=

# Start with MTP disabled for the A/B speed test. Change to true to test MTP.
MTP=false
MTP_N_MAX=3

# A40 48 GB: Q6 + 262K context is intended to fit with headroom.
CTX_SIZE=262144
BATCH_SIZE=2048
UBATCH_SIZE=512
PARALLEL=1
GPU_LAYERS=99
N_CPU_MOE=0
FLASH_ATTN=on
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0

# Agentic coding defaults from the model card.
PROFILE=coding
TEMP=0.6
TOP_P=0.95
TOP_K=20
MIN_P=0

# Optional vision.
MMPROJ_FILE=

# Optional API authentication.
API_KEY=

# Optional extra llama-server arguments.
EXTRA_ARGS=
